# 复制成 .env 再填（.env 不进仓库）。生成随机值：openssl rand -hex 32
ENV=prod

# 平台数据库 / New API 数据库
POSTGRES_PASSWORD=
MYSQL_ROOT_PASSWORD=

# New API（转发引擎）
NEWAPI_IMAGE_TAG=v1.0.0-rc.47
NEWAPI_SESSION_SECRET=
# root 的个人访问令牌（PAT）：在 New API 后台「个人设置 → 访问令牌」创建，勾选 user / channel / log / option 权限
NEWAPI_TOKEN=

# 平台
JWT_SECRET=
# 托管 Key 的加密主密钥（泄露即可解出全部 Key，只放服务器；换了就读不出旧 Key）
KEY_ENCRYPTION_KEY=
# 买方在文档里看到的接口地址
PUBLIC_API_BASE=https://api.example.com/v1
# 前端域名（逗号分隔）
CORS_ORIGINS=https://www.example.com
